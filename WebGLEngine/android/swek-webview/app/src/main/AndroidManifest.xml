<?xml version="1.0" encoding="utf-8"?>
<!-- v4043 — SweK WebView wrapper. Permissions are INTERNET only by default: this app opens a page, it does
     not read storage, location, or contacts. CAMERA/RECORD_AUDIO are commented rather than deleted because the
     avatar/face pages genuinely use them — uncomment BOTH the permission and you will also need a runtime
     request; leaving them declared-but-unused would make the install prompt ask for more than the app does. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.swek.webview">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- v4896 -- SweK HOME needs to SEE which apps can be launched, and on Android 11+ an app sees almost nothing by default. These two
         <queries> intents are the narrow way: the launcher categories and nothing else. QUERY_ALL_PACKAGES is NOT declared on purpose --
         it is the broad permission, Play-restricted, and a home screen does not need to read the whole package list to draw a shelf. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>
    <!-- <uses-permission android:name="android.permission.CAMERA" /> -->
    <!-- <uses-permission android:name="android.permission.RECORD_AUDIO" /> -->

    <!-- v4117 — ANDROID TV (the Shield). Keith asked whether the browser-only node could run there; these three
         lines are what decide whether the APK is even VISIBLE on one, and all three are easy to miss because
         nothing fails loudly without them — the app installs and then simply is not in the launcher.

         *** touchscreen required=false IS THE ONE THAT ACTUALLY BLOCKS THE INSTALL. *** Android assumes an app
         requires a touchscreen unless told otherwise, and a TV has none, so without this line the Shield
         considers the app incompatible outright. leanback=false (not true) is deliberate: `false` means "I know
         how to be a TV app" while still installing on phones, where this wrapper is already used. Marking it
         required would strand every phone that has it today. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Engine pages are WebGL; a TV without it should not be offered the app. -->
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_compass"
        android:banner="@drawable/tv_banner"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:theme="@android:style/Theme.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- v4117 — WITHOUT THIS THE APK INSTALLS ON A SHIELD AND NEVER APPEARS IN THE LAUNCHER. The TV
                     home screen lists LEANBACK_LAUNCHER only; a plain LAUNCHER category is invisible to it, so
                     the app can only be started with adb or a sideload file manager. Both categories are kept,
                     because the same APK still has to be a normal phone app. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v4896 -- SWEK HOME. A SECOND launcher activity in the same APK (one install, one signing key). HOME + DEFAULT is what makes
             Android offer it when the owner chooses a home screen; it is NEVER made the home screen by this APK, and the stock one is
             never disabled by it. LEANBACK_LAUNCHER also lists it in the TV's app row, so it can be started once without being Home. -->
        <activity
            android:name=".LauncherActivity"
            android:label="@string/home_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
