          "type": "notAllBlack",
          "minNonBlackFrac": 0.03
        },
        {
          "type": "notUniform",
          "minUniqueColors": 20
        },
        {
          "type": "edgeBiasProfile",
          "maxEdgeBias": 0.25,
          "maxAsymmetry": 0.25
